# --- App ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173

# --- Database (Render Postgres connection string in prod) ---
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# --- Redis (BullMQ + Socket.IO adapter) --- 
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=4

# --- Auth ---
JWT_SECRET=change-me-in-prod-at-least-32-chars-min-32-chars
JWT_ISSUER=tcg-toolkit
JWT_AUDIENCE=tcg-toolkit-api
JWT_ACCESS_TTL_SECONDS=3600
REFRESH_TTL_DAYS=30
REFRESH_COOKIE_NAME=tcg_refresh
# COOKIE_DOMAIN=.theturbocomp.com

# --- Firebase Authentication migration ---
# Leave unset until the additive users.firebase_uid migration has deployed.
# FIREBASE_PRIVATE_KEY may use literal \n sequences; the API normalizes them.
# For local emulator use, FIREBASE_PROJECT_ID plus FIREBASE_AUTH_EMULATOR_HOST
# is sufficient and service-account credentials are not required.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQDHD/oQLqXsSfWy\nXsw8tgvWTXs3K5sF7jArSexChi1HQa0TKWIQzEOe+k2tcKayi64rvzY6wjJtNdHD\nMeaoVSzR/t4YdfGvuO1vVnnIio6TD5tTZgMTvbXcSN8ltn5rnvgTcsjpoZjvFRtd\n8DfbhoCI2BTfV3vFTfYt7ZF0j8ICO0/VttOMGKQ9m9yY5Fe/ytFsD513Ew4BwdrW\nIzFQA94A4zNxNN/1YxIZae1ILnrhBbuRydbFQENvvIAtFLYHIQGguESS5YkJryZE\nBCo29lInZK6gGDZCKnDk/cbREOwtmqojBvY6ihnezqaHZhjlIwdnZ9f4TwJho3H7\nUsEDfXIVAgMBAAECggEAKhbdt8g1OwXUVnem1Xtke1Z8pAirSZC4TJ7fvp0iO7vO\nPYv1eTnHXnjsLazxAjV4iTVv4PKouOC1ToFhlNwVkv1BtohRpucCBRWSwG1TghK9\ns9+Q7P6i0kXyMMYqatT8/Re7FXMepAahd7ZQCTGiQcz2dNbJi8lVMRbXN38h9Vh3\nqkOyNf50jhFptXJ2DW2ip+FYgsOe3maQstl8ZahZ5Qq7oj82WTlabZMxlQzoaq0n\nr000BJ+j00xCPbVCDvxHlQ4Banli/2vTkNpyk+4TmAU6CWM0UgYHd8LckSXSq01L\n/36RRTGvzhbt6Dmhhjx97PNL2yo0JXuuN+yzHm33oQKBgQDladY2F8utPD6jrjeS\nbUWk2XiUA54PcDw/MyREa8FWocqmemOiNRnlDO1vSF4bziEFAOTK8sU3+gfk4GjY\nKUTjo6Sh/dO73BnDOOItEYp5UIqDo7yRMEDUcNv4zyEJlyJO4jYGUsd/pB6prtFs\nGHL+WpMA2O74F7SEAeIUCrT7nQKBgQDeIbIpXeW4PPHaZ3doTkIlukEpHTdL8FyO\nU9RbEgaRsP/3mU19OJ1/6Gmp8gXiFWU26vWmFjbUNDZOOY9BDSEuuGDB0E1ashXW\n+fOJRIUltaN2z9lB/MoyEDdgdD/h+c7GNJgYf33JB3G/V4Ivzdnp8xLvuNKTaWYA\nsj3CZlWy2QKBgQCMsHZE4BzxVVPYz1uXOdoO+asfooRJVXwtCfEA4NBFj50WsVHu\nxP/nXyExMME97hCD4ANvjqhx5qz2qMTDY7OyosWw7lfuClHmTjkuiGZSdZksl7pp\nk5z+a2QLVwMcvYm1tLaK9DMSTRTc3K/jya6j2+nxCBitHuR+XCVIQzSwZQKBgGqQ\nH7hYo2vPUPdFy7LuWC1hPQFMUsrLdJuS+7z02NHr5+AQW2xHTMef55Dv2oKrYPMH\npPEYlxUWNzcvxdmfQtv29/QCyhlIddG792lSxc1hZhoJfGB7tURvIyHSoxL1lIzh\njlWyU9WtDJSOlpX4WyIwylTWha7SUWzkFVy9Wz+BAoGAUZK+pfR2L/z9ZjMm2xs3\niLUaPH4lHwTRhpLvQuyDwpog8ADoGhanzH8WMkht/Le6ap2jT36ySJMGx1xzSjhj\nEhRC4eqR4h5BqFE3v7x5iYCJ9LoIjXadboKGIwOQS22kVKGgPtgKpPEjcjebnnEQ\nVnbo4GPQqrCDDGr5wupXtv0=\n-----END PRIVATE KEY-----\n
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- Vault (encrypts third-party creds stored in Postgres) ---
# 32-byte key, base64 or hex.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# WARNING: losing this key makes every stored Clover/PkmnPrices credential unrecoverable.
CONFIG_ENCRYPTION_KEY=

# --- Clover webhook protocol detail (not a secret) ---
CLOVER_WEBHOOK_SIGNATURE_HEADER=x-clover-signature

# --- First-boot seed only ---
# These are read once by `npm run seed:configs -w @tcg/api` to import existing
# credentials into the encrypted Postgres tables. After seeding, remove them.
# Day-to-day credential management happens in the web app at /settings/integrations.
# CLOVER_BASE_URL=https://sandbox.dev.clover.com
# CLOVER_ACCESS_TOKEN=
# CLOVER_MERCHANT_ID=


# CLOVER_WEBHOOK_SIGNING_SECRET=

# --- Observability ---
SENTRY_DSN=

# --- Email (password reset, future notifications) ---
# In dev, leave RESEND_API_KEY blank: the reset link will be printed to the
# API terminal AND appended to apps/api/.tmp/dev-emails.log so you can grab
# it without scrolling. Tail it with:
#   Get-Content -Wait apps/api/.tmp/dev-emails.log
#
# To send real emails from dev to your inbox:
#   1. Create a free account at https://resend.com
#   2. From the dashboard → API Keys → generate one
#   3. Paste it here as RESEND_API_KEY
#   4. Without a verified domain you MUST keep MAIL_FROM as the default
#      `onboarding@resend.dev` AND you can only send to the email address you
#      registered with Resend. Add your own domain in the Resend dashboard to
#      send to any recipient.
RESEND_API_KEY=
MAIL_FROM=TCG Toolkit <onboarding@resend.dev>

# Absolute URL of the web app, used inside emails (password reset link, etc.).
APP_BASE_URL=http://localhost:5173
